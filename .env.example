# ── Server-only (read by API routes; never bundled into the app) ─────────────────
# Neon connection string (use the pooled connection string from the Neon console)
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require

# Admin gate. Generate secrets with:  openssl rand -base64 48
ADMIN_PASSCODE=change-me-to-a-long-passphrase
ADMIN_TOKEN_SECRET=change-me-to-at-least-32-random-characters-0000
ADMIN_SESSION_HOURS=12

# ── Client (EXPO_PUBLIC_* ships inside the app — never put secrets here) ─────────
# Leave empty in development; set to the deployed API origin for release builds.
EXPO_PUBLIC_API_URL=
